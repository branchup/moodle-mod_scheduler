{{=<% %>=}}

<style rel="text/css">
</style>

<core-course-module-description description="<% scheduler.intro %>" component="mod_scheduler" componentId="<% cmid %>"></core-course-module-description>

<div class="ion-padding mod_scheduler-student-view">

    <%# haspastslots %>
        <h3><%# str %>attendedslots, mod_scheduler<%/ str %></h3>
        <ion-list>
            <%#pastslots%>
                <ion-item button core-site-plugins-new-content method="slot" [args]="{cmid: <% cmid%>, id: <% id %>}">
                    <ion-label>
                        <h2><% timeformatted.date %></h2>
                        <p><% timeformatted.starttime %> - <% timeformatted.endtime %></p>
                    </ion-label>
                </ion-item>
            <%/pastslots%>
        </ion-list>
    <%/ haspastslots %>

    <%# hasupcomingslots %>
        <h3><%# str %>upcomingslots, mod_scheduler<%/ str %></h3>
        <ion-list>
            <%#upcomingslots%>
                <ion-item button core-site-plugins-new-content method="slot" [args]="{cmid: <% cmid%>, id: <% id %>}">
                    <ion-label>
                        <h2><% timeformatted.date %></h2>
                        <p><% timeformatted.starttime %> - <% timeformatted.endtime %></p>
                    </ion-label>
                </ion-item>
            <%/upcomingslots%>
        </ion-list>
    <%/ hasupcomingslots %>

    <%^ hasbookableslots %>
        <%# nobookingmessage %>
            <p><% . %></p>
        <%/ nobookingmessage %>
    <%/ hasbookableslots %>

    <%# hasbookableslots %>
        <h3><%# str %>availableslots, mod_scheduler<%/ str %></h3>
        <%# bookingmessage %>
            <p><% . %></p>
        <%/ bookingmessage %>
        <ion-list>
            <%#bookableslots%>
                <ion-item button core-site-plugins-new-content method="slot" [args]="{cmid: <% cmid%>, id: <% id %>}">
                    <ion-label>
                        <h2><% timeformatted.date %></h2>
                        <p>
                            <% timeformatted.starttime %> - <% timeformatted.endtime %>
                            <!--<%# hasappointmentlocation %> @ <% appointmentlocation %> <%/ hasappointmentlocation %> -->
                        </p>
                    </ion-label>
                    <%^ isunlimited %>
                        <%^ isfull %>
                            <ion-note slot="end"><% ntaken %> / <% maxappointments %></ion-note>
                        <%/ isfull %>
                        <%# isfull %>
                            <ion-note slot="end"><%# str %>full, mod_scheduler<%/ str %></ion-note>
                        <%/ isfull %>
                    <%/ isunlimited %>
                </ion-item>
            <%/bookableslots%>
            <%#hasmorebookableslots%>
                <ion-item button fill="clear" expand="block" core-site-plugins-new-content method="student_bookable_slots" [args]="{cmid: <% cmid %>, page: 0}" title="<%# str %>availableslots, mod_scheduler<%/ str %>">
                    <%# str %>viewmoreoptions, mod_scheduler<%/ str %>
                </ion-item>
            <%/hasmorebookableslots%>
        </ion-list>
    <%/ hasbookableslots %>

    <!-- Trigger event when the template is loaded. -->
    <span core-site-plugins-call-ws-on-load name="mod_scheduler_booking_form_viewed" [params]="{cmid: <% cmid %>}" [preSets]="{getFromCache: 0, saveToCache: 0}"></span>
</div>
